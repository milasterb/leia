# Anthropic API key — the only required secret. NEVER commit the real one.
ANTHROPIC_API_KEY=your-key-here

# Models. Defaults are safe; bump COMPANION_MODEL to a newer Sonnet if you like.
ROUTER_MODEL=claude-haiku-4-5-20251001
COMPANION_MODEL=claude-sonnet-4-6

# Demo budget guards
COMPANION_MAX_TOKENS=1200
WEB_SEARCH_MAX_USES=3
MAX_TASKS_PER_MINUTE=8
MAX_SESSION_CONCURRENT=2
MAX_GLOBAL_CONCURRENT=4

# Comma-separated list of allowed origins for CORS ("*" while developing)
WEB_ORIGIN=*

# PORT is set by Render automatically; only needed locally
# PORT=8787
